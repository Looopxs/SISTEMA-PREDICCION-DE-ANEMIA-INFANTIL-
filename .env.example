# ==============================================================================
# NutriPredict AI — Variables de Entorno de Configuración (.env.example)
# ==============================================================================

# Entorno: development | production | test
ENVIRONMENT=development

# Base de Datos (SQLite por defecto para desarrollo local sin dependencias externas; PostgreSQL para producción)
DATABASE_URL=sqlite:///./nutripredict.db
# DATABASE_URL=postgresql://nutripredict_user:NutriPredictSecure2026!@localhost:5432/nutripredict_db

# Cola y Caché Redis (opcional para desarrollo local; obligatorio para producción en clúster)
REDIS_URL=redis://localhost:6379/0

# Seguridad y Criptografía de Tokens JWT
SECRET_KEY=nutripredict_research_dev_secret_key_change_in_production_2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Directorios Locales de Artefactos y Cache
ARTIFACTS_DIR=./storage/artifacts
CACHE_DIR=./storage/cache
REPORTS_DIR=./storage/reports
MPLCONFIGDIR=./storage/cache

# Frontend Next.js
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
PORT=3000

